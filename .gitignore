# EcoSentinel - Git Ignore Rules

# Python environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]

# Environment variables and credentials
.env
.env.*
*.pem
*.key
credentials.json
secrets.json

# Jupyter checkpoints
.ipynb_checkpoints/

# Research datasets
data/raw/
data/processed/

# Trained models
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt

# Temporary files
*.log
*.tmp

# Editor settings
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# Testing caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
